{
  "name": "polmaise-bowling-club-website-baseline",
  "version": "0.0.0",
  "private": true,
  "description": "Development-only baseline and verification tooling for the Polmaise Bowling Club website.",
  "type": "module",
  "scripts": {
    "build": "node tools/build-site.mjs",
    "baseline": "npm run baseline:update && npm run baseline:summary",
    "baseline:update": "npm run build && playwright test --update-snapshots",
    "baseline:summary": "node tools/summarize-baseline.mjs",
    "test": "npm run build && playwright test",
    "test:ci": "playwright test tests/ci-gate.spec.js tests/build-output.spec.js tests/internal-links.spec.js tests/javascript-interactions.spec.js --project=desktop --project=mobile",
    "test:diagnostic": "playwright test tests/navigation-hit-target.spec.js tests/rapid-navigation.spec.js tests/external-dependency-resilience.spec.js",
    "test:audit": "playwright test tests/page-audit.spec.js",
    "test:build": "playwright test tests/build-output.spec.js",
    "test:html": "playwright test tests/html-validation.spec.js",
    "test:links": "playwright test tests/internal-links.spec.js",
    "test:visual": "playwright test tests/visual-regression.spec.js",
    "test:report": "playwright show-report"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@playwright/test": "^1.63.0",
    "axe-core": "^4.13.0",
    "html-validate": "^10.9.0",
    "sharp": "^0.35.4"
  }
}
