    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script>
        // Applies the saved theme before first paint so there is no flash of the
        // wrong theme. The day theme is the default and needs no JavaScript.
        (function () {
            try {
                var saved = window.localStorage.getItem('polmaise-theme');
                document.documentElement.setAttribute('data-theme', saved === 'dark' ? 'dark' : 'light');
            } catch (error) {
                document.documentElement.setAttribute('data-theme', 'light');
            }
        })();
    </script>
{# Stage 11: the header wordmark and navigation are above the fold on every
   page. Loading their fonts up front means the first paint already has the
   real metrics, so the navigation cannot re-flow under the user's cursor.
   These are the same files the stylesheet requests — no extra downloads. #}
    <link rel="preload" href="{{ prefix }}vendor/fonts/files/open-sans-400-normal-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ prefix }}vendor/fonts/files/playfair-display-400-normal-latin.woff2" as="font" type="font/woff2" crossorigin>
{% if headVariant == "icon-first" %}
    <link rel="icon" type="image/x-icon" href="{{ (assetPrefix + "Images/polmaise_logo_favicon.png") | imageOriginal }}">
    <title>{{ pageTitle | safe }}</title>
    <link rel="stylesheet" href="{{ prefix }}styles.css">
{% elif headVariant == "styles-first" %}
    <title>{{ pageTitle | safe }}</title>
    <link rel="stylesheet" href="{{ prefix }}styles.css">
    <link rel="icon" type="image/x-icon" href="{{ (assetPrefix + "Images/polmaise_logo_favicon.png") | imageOriginal }}">
{% else %}
    <title>{{ pageTitle | safe }}</title>
    <link rel="icon" type="image/x-icon" href="{{ (assetPrefix + "Images/polmaise_logo_favicon.png") | imageOriginal }}">
    <link rel="stylesheet" href="{{ prefix }}styles.css">
{% endif %}
{# Stage 10: fonts, jQuery, Lightbox2 and Font Awesome are self-hosted in
   vendor/ so no page blocks on a third-party CDN (see
   tools/fetch-vendor-assets.mjs). #}
    <link rel="stylesheet" href="{{ prefix }}vendor/fonts/fonts.css">
{% set canonicalUrl %}{{ site.url }}{{ page.url | replace(" ", "%20") }}{% endset %}
{% set socialImage %}{{ site.url }}{{ socialImagePath | default(site.defaultSocialImage, true) }}{% endset %}
    <meta name="description" content="{{ metaDescription | default(site.description, true) }}">
    <link rel="canonical" href="{{ canonicalUrl }}">
    <meta property="og:type" content="{{ ogType | default('website') }}">
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:title" content="{{ pageTitle }}">
    <meta property="og:description" content="{{ metaDescription | default(site.description, true) }}">
    <meta property="og:url" content="{{ canonicalUrl }}">
    <meta property="og:image" content="{{ socialImage }}">
    <meta property="og:locale" content="en_GB">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ pageTitle }}">
    <meta name="twitter:description" content="{{ metaDescription | default(site.description, true) }}">
    <meta name="twitter:image" content="{{ socialImage }}">
    <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@graph": [
                {
                    "@type": "SportsOrganization",
                    "@id": "{{ site.url }}/#organisation",
                    "name": "{{ site.name }}",
                    "url": "{{ site.url }}/",
                    "email": "{{ site.email }}",
                    "telephone": "{{ site.telephone }}",
                    "address": {
                        "@type": "PostalAddress",
                        "streetAddress": "{{ site.address.streetAddress }}",
                        "addressLocality": "{{ site.address.addressLocality }}",
                        "addressRegion": "{{ site.address.addressRegion }}",
                        "postalCode": "{{ site.address.postalCode }}",
                        "addressCountry": "{{ site.address.addressCountry }}"
                    },
                    "sameAs": ["{{ site.facebook }}"]
                },
                {
                    "@type": "WebSite",
                    "@id": "{{ site.url }}/#website",
                    "name": "{{ site.name }}",
                    "url": "{{ site.url }}/",
                    "publisher": { "@id": "{{ site.url }}/#organisation" },
                    "inLanguage": "en-GB"
                }
                {%- if ogType == "article" %},
                {
                    "@type": "Article",
                    "headline": "{{ pageTitle }}",
                    "description": "{{ metaDescription }}",
                    "image": "{{ socialImage }}",
                    "mainEntityOfPage": "{{ canonicalUrl }}",
                    "author": { "@id": "{{ site.url }}/#organisation" },
                    "publisher": { "@id": "{{ site.url }}/#organisation" },
                    "inLanguage": "en-GB"
                }
                {%- endif %}
            ]
        }
    </script>
{% if jquery %}
    <script src="{{ prefix }}vendor/jquery/jquery-3.6.0.min.js"></script>
{% endif %}
{% if lightboxCss %}
    <link rel="stylesheet" href="{{ prefix }}vendor/lightbox2/css/lightbox.min.css">
{% endif %}
{% if lightboxScript == "head" %}
    <script src="{{ prefix }}vendor/lightbox2/js/lightbox.min.js"></script>
{% endif %}
    <link rel="stylesheet" href="{{ prefix }}vendor/fontawesome/css/all.min.css">
