{% set isHistory = newsSection == "history" %}
{% set sectionLabel = "History" if isHistory else category %}
{% set pageTitle = title | newsPageTitle %}
{% set metaDescription = excerpt %}
{% set ogType = "article" %}
{% set socialImagePath = image | replace("./", "/") %}
{% set bodyClass = "article-page" %}
{% set prefix = "../../../" %}
{% set assetPrefix = "../../../" %}
{% set navActive = "news" %}
{% set homeHref = "../../../index.html" %}
{% set newsHref = "../../../news.html" %}
{# Shared page defaults. Without these the header renders an icon-less burger
   button and script.js is never loaded, so the article pages had no working
   mobile menu, theme toggle or image lightbox. #}
{% set headVariant = "standard" %}
{% set mobileMenuIcon = "fas fa-bars" %}
{% set mobileNavDropdown = false %}
{% set scriptJs = true %}
{% set jquery = false %}
{% set lightboxCss = false %}
{% set lightboxScript = false %}
{% set facebookLink = true %}
<!DOCTYPE html>
<html lang="en">
<head>
{% include "head.njk" %}
<style>
    /* Article pages reuse the shared editorial components in styles.css; this
       block only carries the lightbox chrome that zoomable images need. */
    .lightbox {
        display: none;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.9);
        overflow: auto;
        text-align: center;
    }
    .lightbox-content {
        margin: 50px auto 0;
        display: block;
        max-width: 90%;
        max-height: 90%;
    }
    .lightbox-caption {
        margin: 20px auto;
        width: 80%;
        max-width: 700px;
        color: var(--color-on-inverse);
    }
    .lightbox-close {
        position: absolute;
        top: 15px;
        right: 25px;
        color: var(--color-on-inverse);
        font-size: 35px;
        font-weight: bold;
        cursor: pointer;
        background: none;
        border: 0;
    }
    .zoomable-image {
        cursor: zoom-in;
    }
</style>
</head>
<body>
{% include "header.njk" %}
<main>
    <article class="article">
        <div class="container">
            {# A plain div: a nested <header> would inherit the site header's
               sticky positioning and follow the reader down the page. #}
            <div class="article-header">
                <p class="news-eyebrow">
                    <a href="{{ newsHref }}">News &amp; Events</a>
                    {%- if isHistory %} · From the Green, Through the Years{% endif %}
                </p>
                <h2>{{ title }}</h2>
                <p class="news-meta-row">
                    {# Derived from the ISO date so no page can print a raw
                       JavaScript Date (see tools/news-dates.mjs). #}
                    {%- if isoDate %}<time datetime="{{ isoDate }}">{{ isoDate | newsDate }}</time>{% endif %}
                    <span class="news-chip">{{ sectionLabel }}</span>
                    {%- if isHistory and year %} <span>{{ year }}</span>{% endif %}
                </p>
            </div>

            {# Historical items lead with their own featured image inside the body. #}
            {%- if image and not isHistory %}
            <figure class="article-hero">
                {%- set heroImage = prefix ~ (image | replace("./", "")) %}
                {% photoImage heroImage, imageAlt, { role: "content", sizes: "(max-width: 900px) 92vw, 900px", loading: false, class: "zoomable-image" } %}
                {%- if imageCaption %}<figcaption>{{ imageCaption }}</figcaption>{% endif %}
            </figure>
            {%- endif %}

            <div class="article-body">
                {{ content | safe }}
            </div>

            {# Previous/next come from the news index (newest first) rather than
               the Eleventy collection, so the one undated story stays at the
               end of the list instead of relying on the file timestamp. #}
            {%- if isHistory %}
                {%- set siblings = newsArchive.history | reverse %}
            {%- else %}
                {%- set siblings = newsArchive.articles %}
            {%- endif %}
            {%- set currentIndex = 0 %}
            {%- for entry in siblings %}
                {%- if entry.permalink == permalink %}{% set currentIndex = loop.index0 %}{% endif %}
            {%- endfor %}
            <nav class="article-nav" aria-label="More articles">
                {%- set newer = siblings[currentIndex - 1] %}
                {%- set older = siblings[currentIndex + 1] %}
                {%- if newer %}
                <a href="{{ prefix }}{{ newer.permalink | replace('/', '', 1) }}">
                    <span>Newer</span>
                    {{ newer.title }}
                </a>
                {%- else %}<span></span>{% endif %}
                {%- if older %}
                <a href="{{ prefix }}{{ older.permalink | replace('/', '', 1) }}" class="article-nav-older">
                    <span>Older</span>
                    {{ older.title }}
                </a>
                {%- endif %}
            </nav>

            <p class="article-back">
                <a class="btn secondary-btn" href="{{ newsHref }}">Back to News &amp; Events</a>
            </p>
        </div>
    </article>
</main>

{% include "footer.njk" %}
{% include "scripts.njk" %}

<div id="imageLightbox" class="lightbox" role="dialog" aria-modal="true" aria-label="Image viewer">
    <button type="button" class="lightbox-close" aria-label="Close image viewer">&times;</button>
    {# The viewer copies the clicked photograph into this image before it is
       shown, so it starts on the page favicon — already cached from <head> —
       rather than an empty src. #}
    <img class="lightbox-content" id="lightboxImage" src="{{ (assetPrefix + 'Images/polmaise_logo_favicon.png') | imageOriginal }}" width="64" height="64" alt="">
    <p class="lightbox-caption"></p>
</div>

</body>
</html>
